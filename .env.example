# CeylonGo Backend - Environment Variables Configuration

# Database Configuration (MSSQL via pyodbc)
DB_SERVER=.\\SQLEXPRESS
DB_NAME=CeylonGoDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERTIFICATE=yes

# JWT Authentication Configuration
# Replace JWT_SECRET_KEY with a cryptographically secure random string in production
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-placeholder-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Comma-separated list of additional allowed origins for frontend applications
# Angular development defaults (http://localhost:4200, http://127.0.0.1:4200) are included by default
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Email & SMTP Configuration (Password Reset Flow)
# Leave SMTP_HOST empty for local development to log reset links instead of sending real emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ceylongo.com
SMTP_FROM_NAME=CeylonGo
SMTP_USE_TLS=true
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password

# Rate Limiting Configuration
CHECK_EMAIL_RATE_LIMIT=10
CHECK_EMAIL_RATE_WINDOW_SECONDS=60
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=60
